# Copy to orchestra.env, chmod 600. Never commit the copy. Meaning of each: orchestra/docs/OPERATIONS.md "Ayarlar".
# Restricted live key: Checkout Sessions write, Charges and Refunds write, Payment Intents write.
STRIPE_SECRET_KEY=
# Signing secret of the webhook https://DOMAIN/api/stripe (checkout.session.completed, checkout.session.expired).
STRIPE_WEBHOOK_SECRET=
# name:key pairs, key at least 24 characters: openssl rand -hex 16
ADMIN_KEYS=
# Optional: a message for every paid order and auction step.
SLACK_WEBHOOK_URL=
